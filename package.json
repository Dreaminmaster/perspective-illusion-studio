{
  "name": "perspective-illusion-studio",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Crisp flat-to-3D camera illusions built on Simcraft's Three.js perspective-illusion technique",
  "scripts": {
    "test": "node scripts/verify-skill.mjs",
    "preview": "node render.mjs scene.html preview.mp4 --preview --fps=12 --mink=1 --step=500",
    "render:crisp": "node render.mjs scene.html final_crisp.mp4 --preview --fps=24 --mink=4 --step=500",
    "render:high": "node render_fast.mjs scene.html final_high.mp4 --fps=30 --mink=4 --step=2",
    "explore": "node scripts/serve.mjs"
  },
  "dependencies": {
    "playwright": "1.60.0",
    "three": "0.170.0"
  }
}
